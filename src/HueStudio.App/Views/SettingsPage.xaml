<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HueStudio.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="16" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />

            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Bridge" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="BridgeInfo" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Connect a different bridge" Click="Repair_Click" />
                        <Button Content="Reload everything" Click="Reload_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Demo house" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Use a pretend home with 5 rooms and 15 lights. Handy for trying things without touching your real lights." />
                    <ToggleSwitch x:Name="DemoToggle" Toggled="Demo_Toggled" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Appearance" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <RadioButtons x:Name="ThemeChoice" SelectionChanged="Theme_Changed">
                        <x:String>System</x:String>
                        <x:String>Light</x:String>
                        <x:String>Dark</x:String>
                    </RadioButtons>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="4">
                    <TextBlock Text="About" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="Hue Studio 0.1 · uses the Philips Hue API v2 on your local network." />
                    <TextBlock Text="Keys are encrypted with Windows (DPAPI) and stored in %LOCALAPPDATA%\HueStudio." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
