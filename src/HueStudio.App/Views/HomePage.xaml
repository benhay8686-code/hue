<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HueStudio.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:HueStudio.App.ViewModels">

    <Page.Resources>
        <DataTemplate x:Key="GroupCardTemplate" x:DataType="vm:GroupViewModel">
            <Grid Width="300" Height="168" CornerRadius="{StaticResource CardRadius}">
                <!-- Live colour of the room -->
                <Border Background="{x:Bind Gradient, Mode=OneWay}" Opacity="0.9" />
                <Border Background="#33000000" />
                <Grid Padding="16" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="22" Foreground="White" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" Foreground="White" FontWeight="SemiBold" FontSize="18" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Summary, Mode=OneWay}" Foreground="#DDFFFFFF" FontSize="12" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2" IsOn="{x:Bind IsOn, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" />
                    </Grid>
                    <Slider Grid.Row="2" Minimum="0" Maximum="100" StepFrequency="1"
                            Value="{x:Bind Brightness, Mode=TwoWay}" Header="" />
                </Grid>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="20">
            <Grid>
                <StackPanel>
                    <TextBlock x:Name="Greeting" Style="{StaticResource PageTitle}" Text="Good evening" />
                    <TextBlock x:Name="HomeSummary" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="12">
                    <TextBlock Text="Whole home" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="WholeHomeToggle" Toggled="WholeHome_Toggled" OnContent="" OffContent="" MinWidth="0" />
                </StackPanel>
            </Grid>

            <TextBlock Text="Rooms" Style="{StaticResource SubtitleTextBlockStyle}" />
            <GridView ItemsSource="{x:Bind Rooms}" ItemTemplate="{StaticResource GroupCardTemplate}"
                      SelectionMode="None" IsItemClickEnabled="True" ItemClick="Group_Click" />

            <TextBlock Text="Zones" Style="{StaticResource SubtitleTextBlockStyle}" />
            <GridView ItemsSource="{x:Bind Zones}" ItemTemplate="{StaticResource GroupCardTemplate}"
                      SelectionMode="None" IsItemClickEnabled="True" ItemClick="Group_Click" />
        </StackPanel>
    </ScrollViewer>
</Page>
