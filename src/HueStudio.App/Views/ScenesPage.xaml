<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HueStudio.App.Views.ScenesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:HueStudio.App.ViewModels">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Text="Scenes" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Click to play. Right-click to play dynamically." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <AutoSuggestBox x:Name="Search" PlaceholderText="Search scenes or rooms" Width="280" HorizontalAlignment="Right"
                            VerticalAlignment="Center" QueryIcon="Find" TextChanged="Search_TextChanged" />
        </Grid>

        <GridView Grid.Row="1" ItemsSource="{x:Bind Visible}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Scene_Click">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="vm:SceneViewModel">
                    <Grid Width="220" Height="130" CornerRadius="{StaticResource CardRadius}">
                        <Border Background="{x:Bind Preview, Mode=OneWay}" />
                        <Border Background="#30000000" />
                        <StackPanel VerticalAlignment="Bottom" Margin="12">
                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" Foreground="White" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind GroupName, Mode=OneWay}" Foreground="#DDFFFFFF" FontSize="12" />
                        </StackPanel>
                        <FontIcon Glyph="&#xE73E;" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10"
                                  Visibility="{x:Bind IsActive, Mode=OneWay}" />
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Play" Command="{x:Bind RecallCommand}" />
                                <MenuFlyoutItem Text="Play dynamically" Command="{x:Bind RecallDynamicCommand}" />
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>
