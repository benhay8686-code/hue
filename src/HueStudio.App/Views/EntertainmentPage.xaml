<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HueStudio.App.Views.EntertainmentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="16">
            <TextBlock Text="Entertainment" Style="{StaticResource PageTitle}" />
            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Sync your lights to what's on your PC screen, music or games. Your entertainment areas are listed below. Screen and music sync are coming in the next milestone." />
            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="Coming next"
                     Message="Screen sync streams colours ~50 times a second over the Hue Entertainment API (encrypted DTLS). The packet format is already built and tested; the live screen capture and DTLS link are milestone 3." />
            <ListView x:Name="Areas" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{x:Bind}" Padding="0,8" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
