<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HueStudio.App.Views.LightsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:HueStudio.App.ViewModels"
    xmlns:local="using:HueStudio.App.Views">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Text="Lights" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="Summary" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <AutoSuggestBox x:Name="Search" PlaceholderText="Search lights" Width="280" HorizontalAlignment="Right"
                            VerticalAlignment="Center" QueryIcon="Find" TextChanged="Search_TextChanged" />
        </Grid>
        <ScrollViewer Grid.Row="1">
            <ItemsRepeater ItemsSource="{x:Bind Visible}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="8" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:LightViewModel">
                        <local:LightRow Light="{x:Bind}" />
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</Page>
